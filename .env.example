# Base URL of the server/ Express API (see server/.env.example for its own
# config). Only read server-side (in actions/api-request.ts), never exposed
# to the browser.
API_URL="http://localhost:4000/api"

# Google Sign-In — must be the SAME client ID as server/.env's
# GOOGLE_CLIENT_ID. NEXT_PUBLIC_ vars are inlined into the browser bundle at
# build time; that's expected here — OAuth client IDs are not secret, only
# the client secret would be (and this app never needs one, since the
# backend verifies ID tokens rather than exchanging an auth code). Leave
# unset and the Google button renders as a disabled placeholder instead of
# calling an unconfigured backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
