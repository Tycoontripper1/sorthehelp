DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="30d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Zeptomail (Zoho) — leave ZEPTOMAIL_API_KEY unset in dev and emails will be
# logged to the console instead of sent. Get a key from
# https://www.zoho.com/zeptomail/ (Mail Agents -> API keys).
ZEPTOMAIL_API_KEY=""
ZEPTOMAIL_FROM_EMAIL="noreply@sorthehelp.app"
ZEPTOMAIL_FROM_NAME="Sorthehelp"

# Used to build links in emails (verification, password reset).
APP_URL="http://localhost:3000"

# Telegram — leave TELEGRAM_BOT_TOKEN unset in dev and invite-link generation
# logs a stub link instead of calling the real API. Create a bot via
# @BotFather to get a token, then add it as admin (with "invite users via
# link" permission) to the Telegram group you want to auto-generate access
# links for.
TELEGRAM_BOT_TOKEN=""
